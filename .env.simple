# Parabol - Simple VM Single-Tenant Configuration
# This configuration runs Parabol with SQLite (no PostgreSQL) and
# in-memory pub/sub (no Redis), suitable for a single-tenant deployment
# on a VM with limited resources.

# SERVER CONFIG
HOST='localhost'
PORT='3000'
PROTO='https'
SERVER_SECRET='CHANGE_ME_TO_A_RANDOM_STRING'
SERVER_ID='1'

# DATABASE - SQLite mode
DATABASE_DRIVER='sqlite'
SQLITE_DB_PATH='./parabol.sqlite'

# BILLING - Disabled (no Stripe)
BILLING_ENABLED='false'

# REDIS - Not required (uses in-memory fallback)
# REDIS_URL is intentionally not set; the app will use in-memory pub/sub and caching

# APPLICATION
FILE_STORE_PROVIDER='local'

# MAIL
MAIL_PROVIDER='debug'

# AI (optional - comment out if not needed)
# AI_EMBEDDING_MODELS='[{"model": "text-embeddings-inference:Svenni551/Qwen3-Embedding-0.6B-ONNX-INT8", "url": "http://localhost:3040/", "maxTokens": 4096}]'
# AI_GENERATION_MODELS='[{"model": "text-generation-inference:TheBloke/zephyr-7b-beta", "url": "http://localhost:3050/", "maxTokens": 4096}]'
# AI_EMBEDDER_WORKERS='1'

# LOGGING
AUDIT_LOGS='true'
# LOG_LEVEL='info'
